:80 {
    # Local-only stack: HTTP, no TLS, no domain.
    # Mirrors the prod Caddyfile: static assets served direct, rest proxied to web:80.
    @static {
        path /upload/* /assets/vendor/* /themes/*
    }
    handle @static {
        root * /var/www/html
        file_server
    }

    reverse_proxy web:80 {
        lb_try_duration 5s
        lb_try_interval 250ms
    }
}
