chickenwaves.dk {
    # Serve karenderia static assets directly from disk to avoid hammering
    # Apache + Docker DNS during heavy image fan-out on the menu page.
    @static {
        path /upload/* /assets/vendor/* /themes/*
    }
    handle @static {
        root * /var/www/html
        file_server
        header Cache-Control "max-age=604800, public"
    }

    reverse_proxy web:80 {
        lb_try_duration 5s
        lb_try_interval 250ms
    }
}

www.chickenwaves.dk {
    redir https://chickenwaves.dk{uri} permanent
}
