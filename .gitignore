# Local prod-mirror dev environment.
# Default: everything ignored (319 MB binaries + customer PII in dump + live
# prod DB password in k-config.php + entrypoint scripts).
# Selective whitelist below: only the infra-config & patched install/ files
# we actively maintain go to git as a backup of our changes.
# To rebuild the full directory, see cnc-restaurent-system/rsync/README.md.

cnc-restaurent-system/rsync/*

# Whitelist — top-level infra files (verified secret-free)
!cnc-restaurent-system/rsync/README.md
!cnc-restaurent-system/rsync/Dockerfile
!cnc-restaurent-system/rsync/Caddyfile.local
!cnc-restaurent-system/rsync/cncwaves-tuning.conf
!cnc-restaurent-system/rsync/docker-compose.local.yml
!cnc-restaurent-system/rsync/create_views.sql
!cnc-restaurent-system/rsync/local-fixups.sql
!cnc-restaurent-system/rsync/install/

# Inside install/: ignore by default, drill in only to the patched files
cnc-restaurent-system/rsync/install/*
!cnc-restaurent-system/rsync/install/backoffice/
!cnc-restaurent-system/rsync/install/protected/

cnc-restaurent-system/rsync/install/backoffice/*
!cnc-restaurent-system/rsync/install/backoffice/sw.js
!cnc-restaurent-system/rsync/install/backoffice/assets/
!cnc-restaurent-system/rsync/install/backoffice/themes/
